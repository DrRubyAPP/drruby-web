// DrRuby Prisma schema
// 数据模型主线：a_docs/design/backend_v5.md §3（消费决策域 + App types.ts 契约）
//   既有 mvp2 研究域（SIS/皮肤镜/RAG/cohort 等 19 表）已裁减，详见 a_docs/task/task-9。
// 命名约定：model PascalCase、字段 camelCase，@map/@@map 映射到 snake_case 表名列名
// 主键：普通实体表 id String @id @default(cuid(2))
// 枚举：一律 String + Zod 校验（src/lib/db/enums.ts），不使用 Prisma enum / Postgres 原生 ENUM
// 外键：所有 FK 列建二级索引（Postgres 不自动为 FK 建索引）

generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
  // url 迁移至 prisma.config.ts（Prisma 7 CLI 不再自动读 .env）
}

// =============================================================================
// 1. 账号域（user_account / user_baseline / hormonal_status_log）
// =============================================================================

/// 用户账号 + 身份 + 登录凭证　✅
/// email 大小写不敏感唯一由迁移 raw SQL 补 lower(email) 唯一索引（Prisma @unique 仅作基础约束）
model UserAccount {
  id               String    @id @default(cuid(2))
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  passwordHash     String?   @map("password_hash")
  authProvider     String    @map("auth_provider")
  googleSub        String?   @unique @map("google_sub")
  role             String
  subscriptionTier String    @default("free") @map("subscription_tier")
  timezone         String    @default("UTC")
  status           String    @default("active")
  name             String?
  image            String?
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  baseline         UserBaseline?
  hormonalLogs     HormonalStatusLog[]
  wearableConnections WearableConnection[]
  wearableDailies  WearableDaily[]
  sessions         Session[]
  accounts         Account[]

  // 消费决策域反向 relation（P1，sub-plan-1 §2）
  timelineEvents   TimelineEvent[]
  signals          Signal[]
  decisions        Decision[]
  decisionEntries  DecisionEntry[]
  studyEnrollments StudyEnrollment[]
  consentSettings  ConsentSetting[]
  bodyInsights     BodyInsight[]
  skinScans        SkinScan[]
  experiments      Experiment[]
  hormoneReadings  HormoneReading[]
  contributions    Contribution[]
  healthRecords    HealthRecord[]
  aiReports        AiReport[]
  photos           Photo[]
  subscription     Subscription?

  // P2（sub-plan-2 §4）
  journeys            Journey[]        @relation("JourneyAuthor")
  notifications       Notification[]
  followUpTasks       FollowUpTask[]
  notificationPreferences NotificationPreference[]

  // P3（B 端多关系需命名，与各 model 的 @relation 名一一对应）
  clinicStaff         ClinicStaff[]         @relation("ClinicStaffUser")
  authorizations      Authorization[]       @relation("AuthorizationPatient")
  skinArchives        SkinArchive[]         @relation("SkinArchivePatient")
  appointments        Appointment[]         @relation("AppointmentPatient")
  clinicReports       ClinicReport[]        @relation("ClinicReportPatient")
  referrals           Referral[]            @relation("ReferralFromUser")
  invoices            Invoice[]             @relation("InvoicePatient")
  treatments          Treatment[]           @relation("TreatmentPatient")
  crmActivities       CrmActivity[]         @relation("CrmActivityPatient")
  collaboratorProfile CollaboratorProfile?  @relation("CollaboratorProfileUser")

  @@index([status, deletedAt], map: "user_account_status_deleted_at_idx")
  @@map("user_account")
}

// =============================================================================
// 认证域（Better Auth：session / account / verification）
// =============================================================================

/// Better Auth 会话（DB session）
model Session {
  id        String      @id
  token     String      @unique
  expiresAt DateTime    @map("expires_at") @db.Timestamptz
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  userId    String      @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_user_id_idx")
  @@map("session")
}

/// Better Auth 账号（OAuth / 凭证；承载 Google 绑定与 provider 信息）
model Account {
  id                    String      @id
  accountId             String      @map("account_id")
  providerId            String      @map("provider_id")
  userId                String      @map("user_id")
  accessToken           String?     @map("access_token")
  refreshToken          String?     @map("refresh_token")
  idToken               String?     @map("id_token")
  accessTokenExpiresAt  DateTime?   @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  user                  UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_user_id_idx")
  @@map("account")
}

/// Better Auth 验证记录（OTP / 邮箱验证）
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

/// 皮肤基线档案（1:1 user_account）　✅
model UserBaseline {
  id                 String   @id @default(cuid(2))
  userId             String   @unique @map("user_id")
  skinType           String?  @map("skin_type")
  fitzpatrickScale   String?  @map("fitzpatrick_scale")
  hormonalStatus     String?  @map("hormonal_status")
  menopauseYear      Int?     @map("menopause_year")
  concernGoals       String[] @map("concern_goals")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user               UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_baseline")
}

/// 激素状态变更历史（追加不覆盖，RAG 必须读完整历史）　✅
model HormonalStatusLog {
  id            String   @id @default(cuid(2))
  userId        String   @map("user_id")
  status        String
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "hormonal_status_log_user_id_idx")
  @@map("hormonal_status_log")
}

// =============================================================================
// 2. Wearable 域（wearable_connection / wearable_daily）
// =============================================================================

/// 第三方设备 + OAuth 授权（MVP 仅 HealthKit 真实写入）　✅
/// access/refresh token 加密列：MVP 为 NULL，Phase 2 启用 AES-256
model WearableConnection {
  id                     String   @id @default(cuid(2))
  userId                 String   @map("user_id")
  provider               String
  accessTokenEncrypted   Bytes?   @map("access_token_encrypted")
  refreshTokenEncrypted  Bytes?   @map("refresh_token_encrypted")
  connectedAt            DateTime @map("connected_at") @db.Timestamptz
  lastSyncedAt           DateTime? @map("last_synced_at") @db.Timestamptz
  isPrimary              Boolean  @default(false) @map("is_primary")
  status                 String
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user                   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "wearable_connection_user_id_idx")
  @@index([provider], map: "wearable_connection_provider_idx")
  @@map("wearable_connection")
}

/// 每日 Wearable 汇总（HealthKit 字段写入，其余 NULL）　🟡
/// 防重唯一约束：(user_id, provider, record_date)
/// record_date = 睡眠发生日期（非同步日期），避免 +1 天偏移
model WearableDaily {
  id                String   @id @default(cuid(2))
  userId            String   @map("user_id")
  recordDate        DateTime @map("record_date") @db.Date
  provider          String
  sleepScore        Decimal? @map("sleep_score")
  deepSleepMin      Int?     @map("deep_sleep_min")
  hrvAvg            Decimal? @map("hrv_avg")
  restingHr         Int?     @map("resting_hr")
  skinTempDelta     Decimal? @map("skin_temp_delta")
  stepCount         Int?     @map("step_count")
  glucoseMean       Decimal? @map("glucose_mean")
  glucoseCv         Decimal? @map("glucose_cv")
  glucoseSpikeCount Int?     @map("glucose_spike_count")
  dataQuality       String?  @map("data_quality")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, recordDate], map: "wearable_daily_user_provider_date_uniq")
  @@index([userId, recordDate], map: "wearable_daily_user_date_idx")
  @@map("wearable_daily")
}

// =============================================================================
// 3. 消费决策域（App types.ts 契约 + backend_v5 §2.3/2.4/2.5）
//    12 张配 repo（sub-plan-5）+ 3 张 schema-only（HealthRecord/Photo/Subscription）
// =============================================================================

/// 身体时间线事件（快速记录 / 上传 / 决策快照）— App getTimeline
model TimelineEvent {
  id         String    @id @default(cuid(2))
  userId     String    @map("user_id")
  decisionId String?   @map("decision_id")
  kind       String    // note|treatment|photo|lab|decision|outcome
  title      String
  detail     String?
  source     String?   // you|wearable|your doctor
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   Decision?   @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt], map: "timeline_event_user_occurred_idx")
  @@index([decisionId], map: "timeline_event_decision_id_idx")
  @@map("timeline_event")
}

/// 设备/化验原始信号（带来源 + 置信度）— App getSignals
model Signal {
  id         String    @id @default(cuid(2))
  userId     String    @map("user_id")
  label      String
  value      String
  unit       String?
  source     String
  confidence String    // observed|possible|not-assessable
  trend      String?   // up|down|flat
  measuredAt DateTime  @map("measured_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt], map: "signal_user_measured_idx")
  @@map("signal")
}

/// 决策（My Decisions）— App getDecisions/getDecision
/// brief（三源快照）存 JSON：{ yourHistory[], similarJourneys{summary,note},
///   evidence{known[],uncertain[]}, questionsForClinician[] }。P1 快照，P2 由引擎回填。
/// goal：该决策服务的目标，取值对齐 user_baseline.concern_goals 词汇（自由文本，
///   无 Goal 实体模型）；旧数据可空，新建必填（Spine: GOAL → CONSIDER → DECIDE → …）。
model Decision {
  id        String    @id @default(cuid(2))
  userId    String    @map("user_id")
  question  String
  goal      String?
  // 决策粗粒度种类：procedure|medication|treatment|test|supplement|lifestyle|product|not_sure
  type      String?
  /// 决策针对的实体/主题（自由文本，如 "Thermage" / "gallbladder removal"）
  topic     String?   @map("topic")
  /// topic 归一化 slug（可空；命中已知语料 key → 专题语料，否则通用占位）
  topicSlug String?   @map("topic_slug")
  /// Contract §5 生命周期：ACTIVE|DECIDED|OBSERVING|LEARNING|COMPLETED|CLOSED
  lifecycle          String    @default("ACTIVE")
  /// Contract §3 Type A/B：action|exploration|unconfirmed（用户永不见字面；默认 unconfirmed）
  decisionKind       String?   @map("decision_kind")
  /// 按 kind 分组的 8 值，可空=未决
  outcome            String?
  /// Type B decided_on_next_step 必带（§3）
  nextStep           String?   @map("next_step")
  /// §8 What Matters Now 排序键 + meaningful activity 刷新
  lastUserActivityAt DateTime  @default(now()) @map("last_user_activity_at") @db.Timestamptz
  brief     Json?
  /// Keep this 置 true（可检索）；Not-now 落库但不出现在任何列表（task-37 Slice 1）
  saved           Boolean   @default(false) @map("saved")
  /// Yourself 轻量文字背景（可编辑、非 append-only，随 Keep 一并保存；不写入 brief）
  yourselfContext String?   @map("yourself_context")
  decidedAt DateTime? @map("decided_at") @db.Timestamptz
  /// Contract §6 freshness gate 时间戳：Reopen 不写、Check now 才写
  freshnessCheckedAt DateTime? @map("freshness_checked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user           UserAccount     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries        DecisionEntry[]
  timelineEvents TimelineEvent[]

  @@index([userId, lastUserActivityAt], map: "decision_user_activity_idx")
  @@index([userId, saved], map: "decision_user_saved_idx")
  @@index([userId, topicSlug], map: "decision_user_topic_slug_idx")
  @@map("decision")
}

/// 决策时间线条目（append-only，原始记录永不覆盖）— backend_v5 §2.3b
/// 无 updatedAt：只增不改
model DecisionEntry {
  id             String   @id @default(cuid(2))
  decisionId     String   @map("decision_id")
  userId         String   @map("user_id")
  text           String
  lifecycleSnapshot String @map("lifecycle_snapshot") // 记录当时决策生命周期
  /// §6 entry 类型；null=历史 observation（向后兼容）
  kind       String? @map("kind")
  /// D3 V1 = Decision.brief JSON 深拷贝 + 原 outcome/nextStep 打包；task-43 切 snapshotId 引用
  synthesis  Json?
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  decision       Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user           UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([decisionId, occurredAt], map: "decision_entry_decision_occurred_idx")
  @@index([userId], map: "decision_entry_user_id_idx")
  @@map("decision_entry")
}

/// 研究目录（消费者可见的招募）— backend_v5 §2.5
model ResearchStudy {
  id                String   @id @default(cuid(2))
  name              String
  description       String?
  irbNumber         String?  @map("irb_number")
  recruitmentStatus String   @map("recruitment_status") // recruiting|closed|completed
  fields            String[] // 采集字段
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  enrollments       StudyEnrollment[]

  @@index([recruitmentStatus], map: "research_study_recruitment_idx")
  @@map("research_study")
}

/// 入组（逐项知情同意，可退出）— App getStudies（Study.status/arm/consentGiven）
model StudyEnrollment {
  id           String    @id @default(cuid(2))
  studyId      String    @map("study_id")
  userId       String    @map("user_id")
  status       String    // enrolled|invited|completed
  arm          String?
  consentGiven Boolean   @default(false) @map("consent_given")
  consentAt    DateTime? @map("consent_at") @db.Timestamptz
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  study        ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user         UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyId, userId], map: "study_enrollment_study_user_uniq")
  @@index([userId], map: "study_enrollment_user_id_idx")
  @@map("study_enrollment")
}

/// 隐私开关（三档）— App getConsent
/// self 档 locked=true 永开不可切；(userId,key) 唯一
model ConsentSetting {
  id          String   @id @default(cuid(2))
  userId      String   @map("user_id")
  key         String   // self|deidentified_contribution|identified_research
  title       String
  description String
  value       Boolean  @default(false)
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key], map: "consent_setting_user_key_uniq")
  @@map("consent_setting")
}

/// 身体洞察（首页 Attention 卡 + Aging Velocity + 模式）— App getAttention/getAgingVelocity
/// P1 规则/占位，P2 洞察引擎回填
model BodyInsight {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  kind      String   // attention|aging_velocity|pattern|change
  tag       String?  // attention 卡
  title     String
  body      String?  // attention 卡
  accent    String?  // attention: red|amber|purple
  label     String?  // aging: 指标名
  value     String?  // aging: 值/文案
  caption   String?  // aging: 说明
  tone      String?  // aging: green|amber|purple
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind], map: "body_insight_user_kind_idx")
  @@map("body_insight")
}

/// 皮肤扫描结果 — App getSkinScan；zones 存 JSON（[{name,status}]）
model SkinScan {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  scannedAt DateTime @map("scanned_at") @db.Timestamptz
  headline  String
  zones     Json     // [{name, status}]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scannedAt], map: "skin_scan_user_scanned_idx")
  @@map("skin_scan")
}

/// N-of-1 实验 — App getExperiments
model Experiment {
  id         String   @id @default(cuid(2))
  userId     String   @map("user_id")
  title      String
  hypothesis String
  status     String   // running|planned|done
  window     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "experiment_user_status_idx")
  @@map("experiment")
}

/// 激素层读数（周期上下文）— App getHormoneLayer
model HormoneReading {
  id         String    @id @default(cuid(2))
  userId     String    @map("user_id")
  marker     String
  value      String
  phase      String
  note       String?
  measuredAt DateTime? @map("measured_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "hormone_reading_user_id_idx")
  @@map("hormone_reading")
}

/// 数据贡献（opt-in，可撤回）— App getDataContribution
model Contribution {
  id          String    @id @default(cuid(2))
  userId      String    @map("user_id")
  title       String
  description String
  shared      Boolean   @default(false)
  sharedAt    DateTime? @map("shared_at") @db.Timestamptz
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "contribution_user_id_idx")
  @@map("contribution")
}

// --- 以下 3 张：P1 消费域但本轮 schema only（无 repo） ---

/// 健康记录/报告上传（lab/imaging/checkup/vitals）— backend_v5 §2.3a
model HealthRecord {
  id           String   @id @default(cuid(2))
  userId       String   @map("user_id")
  kind         String   // lab|imaging|checkup|vitals
  title        String
  source       String?  // you|your doctor|clinic
  objectKey    String?  @map("object_key")   // 对象存储 key（PDF/照片）
  ocrStatus    String   @default("pending") @map("ocr_status") // pending|processing|done|manual
  parsedValues Json?    @map("parsed_values")
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       Photo[]

  @@index([userId, recordedAt], map: "health_record_user_recorded_idx")
  @@map("health_record")
}

/// AI 生成报告（skin|hormone|body）— task-26；规则提炼 findings + LLM 仅润色
/// findings 存 JSON（[{level,tag,title,desc}]，对齐 App mock AIReport）；meta 存 {degraded?, llm?, generatedAt}
model AiReport {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  type      String   // skin|hormone|body
  title     String
  summary   String
  findings  Json?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "ai_report_user_type_idx")
  @@index([userId, createdAt], map: "ai_report_user_created_idx")
  @@map("ai_report")
}

/// 照片（before/after，绑定 report/独立）— backend_v5 §2.3a
model Photo {
  id             String    @id @default(cuid(2))
  userId         String    @map("user_id")
  healthRecordId String?   @map("health_record_id")
  objectKey      String    @map("object_key")
  caption        String?
  takenAt        DateTime? @map("taken_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user           UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthRecord   HealthRecord? @relation(fields: [healthRecordId], references: [id], onDelete: SetNull)

  @@index([userId], map: "photo_user_id_idx")
  @@index([healthRecordId], map: "photo_health_record_id_idx")
  @@map("photo")
}

/// 订阅（Stripe 骨架）— backend_v5 §2.6
model Subscription {
  id                   String    @id @default(cuid(2))
  userId               String    @unique @map("user_id")
  tier                 String    // free|decision
  status               String    // active|canceled|past_due|trialing
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user                 UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "subscription_user_id_idx")
  @@map("subscription")
}

// =============================================================================
// P2 — Library / 社区 / 通知（schema only 本轮）— backend_v5 §2.4
// =============================================================================

/// 经验库 journey（匿名 + 已同意 + 可撤回）
model Journey {
  id            String    @id @default(cuid(2))
  authorUserId  String?   @map("author_user_id") // 匿名化：可空/脱敏
  decisionType  String?   @map("decision_type")
  goal          String?
  concern       String?
  timingContext String?   @map("timing_context")
  summary       String
  outcome       String?
  sourceType    String    @map("source_type") // founder_interview|verified_member|partner_clinic|research_study
  shared        Boolean   @default(true)
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  author        UserAccount? @relation("JourneyAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  updates       JourneyUpdate[]

  @@index([decisionType], map: "journey_decision_type_idx")
  @@index([sourceType], map: "journey_source_type_idx")
  @@map("journey")
}

/// living journey 版本更新
model JourneyUpdate {
  id        String   @id @default(cuid(2))
  journeyId String   @map("journey_id")
  version   Int
  note      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, version], map: "journey_update_journey_version_idx")
  @@map("journey_update")
}

/// 通知 — backend_v5 §3 Notification
model Notification {
  id        String    @id @default(cuid(2))
  userId    String    @map("user_id")
  kind      String
  title     String
  body      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt], map: "notification_user_read_idx")
  @@map("notification")
}

/// 通知偏好（privacy 视图 Notification preferences 开关）— task-35
model NotificationPreference {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  key       String   // weekly_digest|decision_followups|study_updates|product_updates
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key], map: "notification_preference_user_key_uniq")
  @@map("notification_preference")
}

/// 有意义待办（meaningful follow-ups）— backend_v5 §2.3e / §3 FollowUpTask
model FollowUpTask {
  id         String    @id @default(cuid(2))
  userId     String    @map("user_id")
  decisionId String?   @map("decision_id")
  title      String
  dueAt      DateTime? @map("due_at") @db.Timestamptz
  status     String    @default("open") // open|done|dismissed
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "follow_up_task_user_status_idx")
  @@map("follow_up_task")
}

// =============================================================================
// P3 — 诊所门户（schema only 本轮）— backend_v5 §2.7
// =============================================================================

/// 诊所 / 机构（模块化订阅）
model Clinic {
  id             String   @id @default(cuid(2))
  name           String
  planTier       String?  @map("plan_tier")        // basic|full
  enabledModules String[] @map("enabled_modules")  // skin_archive|review_queue|...
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  staff          ClinicStaff[]
  authorizations Authorization[]
  skinArchives   SkinArchive[]
  appointments   Appointment[]
  reports        ClinicReport[]
  referrals      Referral[]
  invoices       Invoice[]
  treatments     Treatment[]
  crmActivities  CrmActivity[]

  @@map("clinic")
}

/// 诊所员工（关联 user_account role=clinic）
model ClinicStaff {
  id        String   @id @default(cuid(2))
  clinicId  String   @map("clinic_id")
  userId    String   @map("user_id")
  title     String?  // doctor|nurse|admin
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic    Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      UserAccount @relation("ClinicStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId], map: "clinic_staff_clinic_user_uniq")
  @@index([userId], map: "clinic_staff_user_id_idx")
  @@map("clinic_staff")
}

/// 跨端授权（consumer → clinic，可随时撤销）— backend_v5 §2.7 核心
model Authorization {
  id        String    @id @default(cuid(2))
  userId    String    @map("user_id")   // consumer（患者）
  clinicId  String    @map("clinic_id")
  scopes    String[]  // 授权的数据范围
  status    String    // active|revoked
  grantedAt DateTime  @map("granted_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user      UserAccount @relation("AuthorizationPatient", fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  audits    AuthorizationAudit[]

  @@unique([userId, clinicId], map: "authorization_user_clinic_uniq")
  @@index([clinicId], map: "authorization_clinic_id_idx")
  @@map("authorization")
}

/// 授权审计日志（append-only）
model AuthorizationAudit {
  id              String   @id @default(cuid(2))
  authorizationId String   @map("authorization_id")
  action          String   // granted|revoked|scope_changed|accessed
  actorUserId     String?  @map("actor_user_id")
  detail          Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  authorization   Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@index([authorizationId, createdAt], map: "authorization_audit_auth_created_idx")
  @@map("authorization_audit")
}

/// Skin Archive（诊所侧照片 + AI 皮肤分析三指标 + 趋势）
model SkinArchive {
  id                String   @id @default(cuid(2))
  clinicId          String   @map("clinic_id")
  patientUserId     String   @map("patient_user_id")
  objectKey         String   @map("object_key")
  inflammatoryScore Decimal? @map("inflammatory_score")
  pigmentationScore Decimal? @map("pigmentation_score")
  textureScore      Decimal? @map("texture_score")
  trend             String?  // improving|stable|declining
  capturedAt        DateTime @map("captured_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic            Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           UserAccount @relation("SkinArchivePatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientUserId], map: "skin_archive_clinic_patient_idx")
  @@map("skin_archive")
}

/// 预约（医生+设备排期，DrRuby 转介联动）
model Appointment {
  id            String   @id @default(cuid(2))
  clinicId      String   @map("clinic_id")
  patientUserId String   @map("patient_user_id")
  staffUserId   String?  @map("staff_user_id")
  referralId    String?  @map("referral_id")
  scheduledAt   DateTime @map("scheduled_at") @db.Timestamptz
  status        String   // scheduled|done|report_review|consultation|canceled
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       UserAccount @relation("AppointmentPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, scheduledAt], map: "appointment_clinic_scheduled_idx")
  @@index([patientUserId], map: "appointment_patient_id_idx")
  @@map("appointment")
}

/// Review Queue：AI 起草 → 医生审阅 → 发送（状态机）
model ClinicReport {
  id             String    @id @default(cuid(2))
  clinicId       String    @map("clinic_id")
  patientUserId  String    @map("patient_user_id")
  reviewerUserId String?   @map("reviewer_user_id")
  status         String    // ai_drafted|in_review|approved|sent
  draftContent   Json?     @map("draft_content")
  finalContent   Json?     @map("final_content")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic         Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        UserAccount @relation("ClinicReportPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, status], map: "clinic_report_clinic_status_idx")
  @@index([patientUserId], map: "clinic_report_patient_id_idx")
  @@map("clinic_report")
}

/// DrRuby Referrals（consumer → clinic，转介 + 分佣）
model Referral {
  id               String    @id @default(cuid(2))
  fromUserId       String    @map("from_user_id")   // consumer
  clinicId         String    @map("clinic_id")
  flaggedMetrics   Json?     @map("flagged_metrics")
  note             String?
  requestedService String?   @map("requested_service")
  status           String    // pending|accepted|declined|completed
  commissionAmount Decimal?  @map("commission_amount")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  fromUser         UserAccount @relation("ReferralFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  clinic           Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status], map: "referral_clinic_status_idx")
  @@index([fromUserId], map: "referral_from_user_id_idx")
  @@map("referral")
}

/// 发票（Treatments & Billing）
model Invoice {
  id            String    @id @default(cuid(2))
  clinicId      String    @map("clinic_id")
  patientUserId String    @map("patient_user_id")
  amount        Decimal
  currency      String    @default("USD")
  status        String    // draft|sent|paid|void
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz
  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       UserAccount @relation("InvoicePatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, status], map: "invoice_clinic_status_idx")
  @@index([patientUserId], map: "invoice_patient_id_idx")
  @@map("invoice")
}

/// 诊所侧治疗/服务记录（Treatments & Billing 中的「治疗」部分）
model Treatment {
  id            String   @id @default(cuid(2))
  clinicId      String   @map("clinic_id")
  patientUserId String   @map("patient_user_id")
  staffUserId   String?  @map("staff_user_id")
  name          String
  type          String?  // thermage|ultherapy|botox|laser|filler|hrt|skincare|other
  status        String   @default("planned") // planned|in_progress|done|canceled
  amount        Decimal?
  currency      String   @default("USD")
  scheduledAt   DateTime? @map("scheduled_at") @db.Timestamptz
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       UserAccount @relation("TreatmentPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, status], map: "treatment_clinic_status_idx")
  @@index([patientUserId], map: "treatment_patient_id_idx")
  @@map("treatment")
}

/// 诊所侧 CRM 跟进/活动日志（CRM & Follow-up）
model CrmActivity {
  id            String   @id @default(cuid(2))
  clinicId      String   @map("clinic_id")
  patientUserId String   @map("patient_user_id")
  staffUserId   String?  @map("staff_user_id")
  type          String   // call|email|note|follow_up|message
  note          String?
  dueAt         DateTime? @map("due_at") @db.Timestamptz
  status        String   @default("open") // open|done|dismissed
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       UserAccount @relation("CrmActivityPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, status], map: "crm_activity_clinic_status_idx")
  @@index([patientUserId], map: "crm_activity_patient_id_idx")
  @@map("crm_activity")
}

