// DrRuby Prisma schema
// 数据模型参考：a_docs/drruby-docs/mvp2/data-model-2.md（24 张消费者数据表）
// 命名约定：model PascalCase、字段 camelCase，@map/@@map 映射到 snake_case 表名列名
// 主键：普通实体表 id String @id @default(cuid(2))；glucose_stream 用 BigInt @default(autoincrement())
// 枚举：一律 String + Zod 校验（src/lib/db/enums.ts），不使用 Prisma enum / Postgres 原生 ENUM
// 外键：所有 FK 列建二级索引（Postgres 不自动为 FK 建索引）

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["postgresqlExtensions"] // v7 已弃用，pgvector 用 raw SQL 处理
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. 账号域（user_account / user_baseline / hormonal_status_log）
// =============================================================================

/// 用户账号 + 身份 + 登录凭证　✅
/// email 大小写不敏感唯一由迁移 raw SQL 补 lower(email) 唯一索引（Prisma @unique 仅作基础约束）
model UserAccount {
  id               String    @id @default(cuid(2))
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  passwordHash     String?   @map("password_hash")
  authProvider     String    @map("auth_provider")
  googleSub        String?   @unique @map("google_sub")
  role             String
  subscriptionTier String    @default("free") @map("subscription_tier")
  timezone         String    @default("UTC")
  status           String    @default("active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  baseline         UserBaseline?
  hormonalLogs     HormonalStatusLog[]
  wearableConnections WearableConnection[]
  wearableDailies  WearableDaily[]
  glucoseStreams   GlucoseStream[]

  @@index([status, deletedAt], map: "user_account_status_deleted_at_idx")
  @@map("user_account")
}

/// 皮肤基线档案（1:1 user_account）　✅
model UserBaseline {
  id                 String   @id @default(cuid(2))
  userId             String   @unique @map("user_id")
  skinType           String?  @map("skin_type")
  fitzpatrickScale   String?  @map("fitzpatrick_scale")
  hormonalStatus     String?  @map("hormonal_status")
  menopauseYear      Int?     @map("menopause_year")
  concernGoals       String[] @map("concern_goals")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user               UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_baseline")
}

/// 激素状态变更历史（追加不覆盖，RAG 必须读完整历史）　✅
model HormonalStatusLog {
  id            String   @id @default(cuid(2))
  userId        String   @map("user_id")
  status        String
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "hormonal_status_log_user_id_idx")
  @@map("hormonal_status_log")
}

// =============================================================================
// 2. Wearable 域（wearable_connection / wearable_daily / glucose_stream）
// =============================================================================

/// 第三方设备 + OAuth 授权（MVP 仅 HealthKit 真实写入）　✅
/// access/refresh token 加密列：MVP 为 NULL，Phase 2 启用 AES-256
model WearableConnection {
  id                     String   @id @default(cuid(2))
  userId                 String   @map("user_id")
  provider               String
  accessTokenEncrypted   Bytes?   @map("access_token_encrypted")
  refreshTokenEncrypted  Bytes?   @map("refresh_token_encrypted")
  connectedAt            DateTime @map("connected_at") @db.Timestamptz
  lastSyncedAt           DateTime? @map("last_synced_at") @db.Timestamptz
  isPrimary              Boolean  @default(false) @map("is_primary")
  status                 String
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user                   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "wearable_connection_user_id_idx")
  @@index([provider], map: "wearable_connection_provider_idx")
  @@map("wearable_connection")
}

/// 每日 Wearable 汇总（HealthKit 字段写入，其余 NULL）　🟡
/// 防重唯一约束：(user_id, provider, record_date)
/// record_date = 睡眠发生日期（非同步日期），避免 +1 天偏移
model WearableDaily {
  id                String   @id @default(cuid(2))
  userId            String   @map("user_id")
  // session_id 占位：任务6 study_session 建表后补 relation
  sessionId         String?  @map("session_id")
  recordDate        DateTime @map("record_date") @db.Date
  provider          String
  sleepScore        Decimal? @map("sleep_score")
  deepSleepMin      Int?     @map("deep_sleep_min")
  hrvAvg            Decimal? @map("hrv_avg")
  restingHr         Int?     @map("resting_hr")
  skinTempDelta     Decimal? @map("skin_temp_delta")
  stepCount         Int?     @map("step_count")
  glucoseMean       Decimal? @map("glucose_mean")
  glucoseCv         Decimal? @map("glucose_cv")
  glucoseSpikeCount Int?     @map("glucose_spike_count")
  dataQuality       String?  @map("data_quality")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user              UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, recordDate], map: "wearable_daily_user_provider_date_uniq")
  @@index([userId, recordDate], map: "wearable_daily_user_date_idx")
  @@map("wearable_daily")
}

/// CGM 原始血糖流（5min/条）　🔵 预留（MVP 不写入）
/// 规模：26周 × 1000 CGM 用户 ≈ 5200 万行
/// 分区策略：(user_id, measured_at) 范围分区，以注释预留，本阶段单表
model GlucoseStream {
  id              BigInt   @id @default(autoincrement()) @db.BigInt
  userId          String   @map("user_id")
  measuredAt      DateTime @map("measured_at") @db.Timestamptz
  glucoseMgdl     Decimal? @map("glucose_mgdl")
  trendArrow      String?  @map("trend_arrow")
  cgmDeviceSerial String?  @map("cgm_device_serial")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt], map: "glucose_stream_user_measured_idx")
  @@map("glucose_stream")
}
