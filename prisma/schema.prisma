}

/// 研究项目（Active projects）
model ResearchProject {
  id                    String   @id @default(cuid(2))
  name                  String
  principalInvestigator String?  @map("principal_investigator")
  irbNumber             String?  @map("irb_number")
  recruitmentStatus     String?  @map("recruitment_status")
