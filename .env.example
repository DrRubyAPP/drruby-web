# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Mailchimp merge fields (must be created in Mailchimp dashboard):
# AGE       — text field (for age range selection)
# CONCERNS  — text field (comma-separated concerns)
# SPEND     — text field (monthly skincare spend)
# WINNING   — text field (what "winning" looks like for user)

# Prisma / PostgreSQL
# 本地：docker compose up -d 后使用以下连接串（host 端口 5433，避开常见占用）
DATABASE_URL="postgresql://drruby:drruby@localhost:5433/drruby?schema=public"

# Better Auth
# BETTER_AUTH_SECRET: 32+ 字节随机串，生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth（Google Cloud Console 创建 OAuth 2.0 客户端）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend（OTP 邮件发送）
# 开发期发件人 onboarding@resend.dev 仅能投递到 Resend 账号本人邮箱
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# OpenAI（Ask DrRuby 代理 + 洞察文案润色）—— 秘钥仅服务端持有，绝不进 NEXT_PUBLIC_*
OPENAI_API_KEY=
# 可选，默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# 可选，默认 https://api.openai.com/v1（可指向 OpenAI 兼容网关）
OPENAI_BASE_URL=https://api.openai.com/v1

# 日志级别（可选，默认 info）：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 中英文切换开关（可选，默认关闭）。默认隐藏语言切换按钮，全站英文。
# 设为 true 可重新开启中英文切换。
NEXT_PUBLIC_ENABLE_LOCALE_SWITCH=false

# 首页登录入口开关（可选，默认关闭）。设为 true 时屏蔽公开页顶栏的登录入口：
# 未登录不显示 Log in 按钮；已登录（浏览器持有 session）也不显示用户头像。
NEXT_PUBLIC_HIDE_HOME_LOGIN=false

# task-46 存储抽象层（My Health 原件上传）
# STORAGE_DRIVER：local（本地磁盘，开发/测试兜底）| r2（Cloudflare R2，生产）。默认 local。
STORAGE_DRIVER=local
# 仅 local 生效：落盘目录，默认项目根 .uploads/（已入 .gitignore）
LOCAL_STORAGE_DIR=.uploads
# 仅 r2 生效：缺任一项且 STORAGE_DRIVER=r2 → 启动报错，不静默降级到 local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
