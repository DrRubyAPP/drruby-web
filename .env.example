# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Mailchimp merge fields (must be created in Mailchimp dashboard):
# AGE       — text field (for age range selection)
# CONCERNS  — text field (comma-separated concerns)
# SPEND     — text field (monthly skincare spend)
# WINNING   — text field (what "winning" looks like for user)

# Prisma / PostgreSQL
# 本地：docker compose up -d 后使用以下连接串
DATABASE_URL="postgresql://drruby:drruby@localhost:5432/drruby?schema=public"
# 迁移 shadow database（prisma migrate dev 需要，本地可指向同库或单独库）
SHADOW_DATABASE_URL="postgresql://drruby:drruby@localhost:5432/drruby_shadow?schema=public"
